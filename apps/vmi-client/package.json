{
  "name": "vmi-client",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --use-system-ca ./node_modules/next/dist/bin/next dev -p 3001",
    "dev:turbo": "node --use-system-ca ./node_modules/next/dist/bin/next dev --turbo",
    "build": "next build",
    "start": "node --use-system-ca ./node_modules/next/dist/bin/next start -p 3001",
    "type-check": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:e2e": "node ./scripts/run-e2e.mjs",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:run": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@repo/auth": "workspace:*",
    "@repo/contracts": "workspace:*",
    "@repo/supabase": "workspace:*",
    "@repo/ui": "workspace:*",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.101.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "16.1.7",
    "next-intl": "^4.8.0",
    "next-themes": "^0.4.6",
    "nuqs": "^2.8.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.10",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^9.39.2",
    "jsdom": "^25.0.1",
    "tailwindcss": "4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "vitest": "^4.0.18"
  }
}
