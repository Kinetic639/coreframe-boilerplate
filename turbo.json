{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "CI",
    "NODE_ENV",
    "EMAIL_FROM",
    "RESEND_FROM_EMAIL",
    "RESEND_FROM_NAME",
    "RESEND_API_KEY",
    "CRON_SECRET",
    "VAPID_PRIVATE_KEY",
    "VAPID_SUBJECT",
    "NEXT_PUBLIC_VAPID_PUBLIC_KEY",
    "KLIPY_API_KEY",
    "SUPABASE_ACCESS_TOKEN",
    "SUPABASE_SERVICE_ROLE_KEY",
    "PORT",
    "PLAYWRIGHT_BASE_URL",
    "E2E_TEST_EMAIL",
    "E2E_TEST_PASSWORD",
    "NEXT_PUBLIC_LOCALE_COOKIE_DOMAIN",
    "NEXT_PUBLIC_AUTH_COOKIE_DOMAIN",
    "NEXT_PUBLIC_AMBRA_SITE_URL",
    "NEXT_PUBLIC_AMBRA_ERP_URL",
    "NEXT_PUBLIC_AMBRA_REQUESTS_URL",
    "NEXT_PUBLIC_AMBRA_VMI_URL",
    "VERCEL_ENV",
    "VERCEL_GIT_COMMIT_SHA"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "$TURBO_ROOT$/packages/app-version/package.json"],
      "env": [
        "RESEND_API_KEY",
        "SUPABASE_ACCESS_TOKEN",
        "SUPABASE_SERVICE_ROLE_KEY",
        "CRON_SECRET",
        "VAPID_PRIVATE_KEY",
        "VAPID_SUBJECT",
        "NEXT_PUBLIC_VAPID_PUBLIC_KEY"
      ],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test:run": {
      "outputs": []
    }
  }
}
