{
  "name": "@repo/app-version",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "description": "The one version of the Ambra system (ERP, website, requests portal, VMI), its changelog and the release script.",
  "exports": {
    ".": "./src/index.ts",
    "./changelog-parser": "./scripts/changelog-parser.mjs"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
