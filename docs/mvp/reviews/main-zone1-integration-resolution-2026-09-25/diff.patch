+function unescapeQuotedValue(quoted: string): string {
+  const inner = quoted.slice(1, -1); // strip surrounding "
+  let out = "";
+  for (let i = 0; i < inner.length; i++) {
+    if (inner[i] === "\\" && i + 1 < inner.length) {
+      out += inner[i + 1];
+      i++;
+    } else {
+      out += inner[i];
+    }
+  }
+  return out;
