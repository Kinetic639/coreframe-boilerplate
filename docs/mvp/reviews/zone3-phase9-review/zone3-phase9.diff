+      id: line.id,
+      productCode: line.product_code,
+      productName: line.product_name,
+      quantity: line.quantity,
+      unit: line.unit,
+      rawText: line.raw_text,
+      wddMatcherLineId: line.wdd_matcher_line_id,
+      contributions: ownContributions,
+    });
+  }
