+/**
+ * @vitest-environment node
+ *
+ * Tests: server/services/wdd-matcher.service.ts -- WddMatcherService.approveSession
+ * (Phase 4, Zone 3 Repair Orders).
+ *
+ * Verifies the atomic state-transition guard lives in the UPDATE's own
+ * WHERE clause (status = 'ready_for_review' is one of the .eq() filters,
+ * not a separate SELECT-then-UPDATE), and that approved_by/approved_at map
+ * onto the returned row exactly as written.
+ */
+import { describe, it, expect, vi } from "vitest";
+import { WddMatcherService } from "../wdd-matcher.service";
+
+function makeChainableUpdateMock(result: { data: unknown; error: unknown }) {
+  const calls: { method: string; args: unknown[] }[] = [];
+  const q: Record<string, unknown> = {};
+  for (const m of ["update", "eq", "select"]) {
+    q[m] = vi.fn().mockImplementation((...args: unknown[]) => {
+      calls.push({ method: m, args });
+      return q;
+    });
+  }
+  q["maybeSingle"] = vi.fn().mockResolvedValue(result);
+  return { from: vi.fn().mockReturnValue(q), calls, query: q };
+}
+
+describe("WddMatcherService.approveSession", () => {
+  it("ready_for_review -> approved succeeds: passes status='ready_for_review' as part of the UPDATE's WHERE, and maps approved_by/approved_at from the returned row", async () => {
+    const approvedRow = {
+      id: "session-1",
+      organization_id: "org-1",
+      branch_id: "branch-1",
+      status: "approved",
+      approved_by: "user-1",
+      approved_at: "2026-09-10T12:00:00.000Z",
+      name: "Session",
+      match_summary: null,
+      created_by: "user-1",
+      created_at: "2026-09-10T10:00:00.000Z",
+      updated_at: "2026-09-10T12:00:00.000Z",
+    };
+    const mock = makeChainableUpdateMock({ data: approvedRow, error: null });
+
+    const result = await WddMatcherService.approveSession(
+      mock as never,
+      "session-1",
+      "org-1",
+      "branch-1",
+      "user-1"
+    );
+
+    expect(result).toEqual({ success: true, data: approvedRow });
+    expect(mock.from).toHaveBeenCalledWith("wdd_matcher_sessions");
+
+    // The UPDATE payload sets status/approved_by/approved_at together.
+    const updateCall = mock.calls.find((c) => c.method === "update");
+    expect(updateCall?.args[0]).toMatchObject({ status: "approved", approved_by: "user-1" });
+
+    // The state-transition guard is one of the .eq() filters on the UPDATE
+    // itself -- not a separate read. All three scoping filters must be
+    // present: id, organization_id, status='ready_for_review' (+ branch_id
+    // when given).
+    const eqCalls = mock.calls.filter((c) => c.method === "eq").map((c) => c.args);
+    expect(eqCalls).toContainEqual(["id", "session-1"]);
+    expect(eqCalls).toContainEqual(["organization_id", "org-1"]);
+    expect(eqCalls).toContainEqual(["status", "ready_for_review"]);
+    expect(eqCalls).toContainEqual(["branch_id", "branch-1"]);
+  });
+
+  it("other states are rejected: zero rows matched (session not ready_for_review) maps to a distinct SESSION_NOT_READY error, not a generic one", async () => {
+    // Zero rows updated (e.g. already 'approved', or 'pending') is not a
+    // Postgres error -- it's a successful UPDATE with no matching row, so
+    // Supabase returns { data: null, error: null } for .maybeSingle().
+    const mock = makeChainableUpdateMock({ data: null, error: null });
+
+    const result = await WddMatcherService.approveSession(
+      mock as never,
+      "session-1",
+      "org-1",
+      "branch-1",
+      "user-1"
+    );
+
+    expect(result.success).toBe(false);
+    expect((result as { success: false; error: string }).error).toContain("SESSION_NOT_READY");
+  });
+
+  it("omits the branch_id filter when branchId is null (org-wide approval scope)", async () => {
+    const mock = makeChainableUpdateMock({
+      data: { id: "session-1", status: "approved" },
+      error: null,
+    });
+
+    await WddMatcherService.approveSession(mock as never, "session-1", "org-1", null, "user-1");
+
+    const eqCalls = mock.calls.filter((c) => c.method === "eq").map((c) => c.args);
+    expect(eqCalls).not.toContainEqual(["branch_id", null]);
+    expect(eqCalls).toContainEqual(["organization_id", "org-1"]);
+  });
+
+  it("maps a raw DB error to a normalized service failure", async () => {
+    const mock = makeChainableUpdateMock({
+      data: null,
+      error: { code: "42501", message: "permission denied for table wdd_matcher_sessions" },
+    });
+
+    const result = await WddMatcherService.approveSession(
+      mock as never,
+      "session-1",
+      "org-1",
+      "branch-1",
+      "user-1"
+    );
+
+    expect(result).toEqual({
+      success: false,
+      error: "You do not have permission to perform this action.",
+    });
+  });
+});
