+++ b/apps/web/supabase/tests/092_wdd_matcher_approval_rls_test.sql
@@ -0,0 +1,126 @@
+-- ============================================================================
+-- TEST: wdd_matcher_sessions approval RLS (Zone 3 Phase 4-6 corrective
+-- review, Finding A)
+-- ============================================================================
+-- Verifies apps/web/supabase-target/supabase/migrations/
+-- 20260911071854_wdd_matcher_sessions_approval_rls_restriction.sql.
+--
+-- Runs the actual UPDATE statements as the `authenticated` role (not
+-- `postgres`, which bypasses RLS entirely) with a real JWT claim set via
+-- request.jwt.claims, so this genuinely exercises RLS -- not just the
+-- policy text. A WITH CHECK failure on a row already matched by USING
+-- raises a hard Postgres error ("new row violates row-level security
+-- policy"), not a silent 0-row update -- that is the expected/correct
+-- signal for the blocked case below, not a test bug.
+--
+-- Uses a real, existing user (the dedicated Zone 3 E2E test account) whose
+-- permission-cache rows are temporarily narrowed to exactly one slug at a
+-- time -- deleted and reinserted within this same transaction, which is
+-- rolled back at the end, so the account's real permissions are unaffected
+-- after the run.
+--
+-- Executed against supabase-target via Supabase MCP. Last run: 2026-09-11,
+-- 3/3 passing. Verified zero residual data after rollback.
+
+BEGIN;
+
+SELECT plan(3);
+
+CREATE TEMP TABLE rls_fixture (session1 uuid, session2 uuid, session3 uuid, e2e_user uuid, org uuid, branch uuid);
+CREATE TEMP TABLE rls_outcomes (test_name text, blocked_or_unchanged boolean);
+GRANT SELECT ON rls_fixture TO authenticated;
+GRANT INSERT, SELECT ON rls_outcomes TO authenticated;
+
+INSERT INTO rls_fixture
+SELECT gen_random_uuid(), gen_random_uuid(), gen_random_uuid(),
+       'c4a24371-42db-4bb8-ab5e-379ebbf7d9c4'::uuid,
+       '9f98fe91-63b8-4986-a2b3-65bdd47684c9'::uuid,
+       'e39b15da-0a8d-4056-b5a2-80eb1da868a6'::uuid;
+
+INSERT INTO wdd_matcher_sessions (id, organization_id, branch_id, name, status)
+SELECT session1, org, branch, 'RLS test 1 - upload-only direct approve attempt', 'ready_for_review' FROM rls_fixture;
+INSERT INTO wdd_matcher_sessions (id, organization_id, branch_id, name, status)
+SELECT session2, org, branch, 'RLS test 2 - approve-only direct approve', 'ready_for_review' FROM rls_fixture;
+INSERT INTO wdd_matcher_sessions (id, organization_id, branch_id, name, status)
+SELECT session3, org, branch, 'RLS test 3 - upload-only legit non-approval update', 'pending' FROM rls_fixture;
+
+-- === Phase 1: narrow the E2E user to upload+read. read is a baseline
+-- visibility permission, orthogonal to the upload-vs-approve distinction
+-- under test -- without it, RLS's SELECT policy hides the row entirely
+-- and every UPDATE would silently affect 0 rows regardless of this fix,
+-- which would make the test meaningless (discovered live while writing
+-- this test: a role given ONLY .upload, with no .read, cannot even see
+-- the row -- a real role always bundles read alongside write). ===
+DELETE FROM user_effective_permissions WHERE user_id = (SELECT e2e_user FROM rls_fixture) AND organization_id = (SELECT org FROM rls_fixture);
+INSERT INTO user_effective_permissions (user_id, organization_id, permission_slug, permission_slug_exact)
+SELECT e2e_user, org, slug, slug FROM rls_fixture, unnest(ARRAY['wdd_matcher.upload','wdd_matcher.read']) AS slug;
+
+SET LOCAL ROLE authenticated;
+SELECT set_config('request.jwt.claims', json_build_object('sub', e2e_user::text, 'role','authenticated')::text, true) FROM rls_fixture;
+
+-- Test 1: upload-only (no approve) tries to directly set status='approved'.
+DO $t1$
+DECLARE
+  v_session uuid;
+  v_actor uuid;
+  v_blocked boolean := false;
+BEGIN
+  SELECT session1, e2e_user INTO v_session, v_actor FROM rls_fixture;
+  BEGIN
+    UPDATE wdd_matcher_sessions SET status = 'approved', approved_by = v_actor, approved_at = now() WHERE id = v_session;
+  EXCEPTION WHEN insufficient_privilege OR OTHERS THEN
+    v_blocked := true;
+  END;
+  INSERT INTO rls_outcomes VALUES (
+    'upload-only cannot directly approve',
+    v_blocked OR (SELECT status <> 'approved' FROM wdd_matcher_sessions WHERE id = v_session)
+  );
+END;
+$t1$;
+
+-- Test 2 setup: the SAME upload-only actor performs a legitimate
+-- non-approval transition -- must still succeed (no regression to the
+-- existing upload/parse/match lifecycle).
+UPDATE wdd_matcher_sessions SET status = 'processing' WHERE id = (SELECT session3 FROM rls_fixture);
+INSERT INTO rls_outcomes
+SELECT 'upload-only can still do non-approval updates',
+       (SELECT status = 'processing' FROM wdd_matcher_sessions WHERE id = (SELECT session3 FROM rls_fixture));
+
+-- === Phase 2: narrow the E2E user to approve+read (no upload) -- a
+-- plausible narrower role, since .approve and .upload are separate slugs. ===
+RESET ROLE;
+DELETE FROM user_effective_permissions WHERE user_id = (SELECT e2e_user FROM rls_fixture) AND organization_id = (SELECT org FROM rls_fixture);
+INSERT INTO user_effective_permissions (user_id, organization_id, permission_slug, permission_slug_exact)
+SELECT e2e_user, org, slug, slug FROM rls_fixture, unnest(ARRAY['wdd_matcher.approve','wdd_matcher.read']) AS slug;
+
+SET LOCAL ROLE authenticated;
+SELECT set_config('request.jwt.claims', json_build_object('sub', e2e_user::text, 'role','authenticated')::text, true) FROM rls_fixture;
+
+-- Test 3: approve-only (no upload) CAN directly approve -- proves the fix
+-- doesn't over-restrict to .upload-only reachability.
+UPDATE wdd_matcher_sessions SET status = 'approved', approved_by = (SELECT e2e_user FROM rls_fixture), approved_at = now()
+WHERE id = (SELECT session2 FROM rls_fixture);
+INSERT INTO rls_outcomes
+SELECT 'approve-only (without upload) CAN directly approve',
+       (SELECT status = 'approved' FROM wdd_matcher_sessions WHERE id = (SELECT session2 FROM rls_fixture));
+
+RESET ROLE;
+
+SELECT ok(
+  (SELECT blocked_or_unchanged FROM rls_outcomes WHERE test_name = 'upload-only cannot directly approve'),
+  'an upload-only actor (no wdd_matcher.approve) is blocked by RLS from directly setting status=approved'
+);
+
+SELECT ok(
+  (SELECT blocked_or_unchanged FROM rls_outcomes WHERE test_name = 'upload-only can still do non-approval updates'),
+  'the same upload-only actor can still perform the existing upload/parse/match lifecycle transitions (no regression)'
+);
+
+SELECT ok(
+  (SELECT blocked_or_unchanged FROM rls_outcomes WHERE test_name = 'approve-only (without upload) CAN directly approve'),
+  'an approve-only actor (no wdd_matcher.upload) can reach the row and directly approve it (the fix does not over-restrict to upload-only reachability)'
+);
+
+SELECT * FROM finish();
+
+ROLLBACK;
