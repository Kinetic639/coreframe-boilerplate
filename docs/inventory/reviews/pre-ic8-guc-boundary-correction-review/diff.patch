diff --git a/apps/web/supabase-target/supabase/migrations/20260919162643_pre_ic8_p0_restore_settings_update_grant_keep_trigger_as_boundary.sql b/apps/web/supabase-target/supabase/migrations/20260919162643_pre_ic8_p0_restore_settings_update_grant_keep_trigger_as_boundary.sql
