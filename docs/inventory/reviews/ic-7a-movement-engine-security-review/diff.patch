diff --git a/apps/web/supabase-target/supabase/migrations/20260916050557_ic7a_harden_inventory_create_and_finalize.sql b/apps/web/supabase-target/supabase/migrations/20260916050557_ic7a_harden_inventory_create_and_finalize.sql
