diff --git a/apps/web/supabase-target/supabase/migrations/20260916065129_ic4_branch_transfer_status_lifecycle.sql b/apps/web/supabase-target/supabase/migrations/20260916065129_ic4_branch_transfer_status_lifecycle.sql
