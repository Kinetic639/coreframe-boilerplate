+ LANGUAGE plpgsql
+ SECURITY DEFINER
+ SET search_path TO 'public'
+AS $function$
+DECLARE
+  v_pz_doc_id uuid;
+  v_mm_doc_id uuid;
+  v_inw_doc_id uuid;
+  v_kor_doc_id uuid;
