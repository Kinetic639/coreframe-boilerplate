{
  "name": "amba-system",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint-staged": "lint-staged",
    "prepare": "node -e \"if (!process.env.CI) require('child_process').execFileSync('husky install', { stdio: 'inherit', shell: true })\"",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test:run",
    "syncpack:lint": "syncpack lint",
    "syncpack:fix": "syncpack fix",
    "syncpack:list": "syncpack list",
    "syncpack:format": "syncpack format"
  },
  "devDependencies": {
    "husky": "^8.0.3",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.1",
    "syncpack": "^14.2.1",
    "supabase": "^2.81.3",
    "turbo": "^2.8.17",
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "claude": "^0.1.2"
  }
}
